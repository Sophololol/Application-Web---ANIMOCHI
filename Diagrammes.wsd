@startuml "Diagramme de classe"
title "Diagramme de classes"
skinparam linetype ortho

class Utilisateur {
    + int id_client <<PK>>
    --
    + String mdp
    + String nom
    + String prenom
    + int argent
    --
    + seConnecter(mdp : String) : boolean
}

class Animal {
    + String nom_animal <<PK>>
    --
    + String type_animal
    + int santé
    + int famine
    + int joie
    + int fatigue
    + Date date_naissance
    --
    + nourrir() : void
    + jouer() : void
    + dormir() : void
    + soigner() : void
}
Utilisateur "1" -- "0..*" Animal : adopter >
class Chat
class perroquet
class canard
class herisson
class lapin
Animal <|-- Chat
Animal <|-- perroquet
Animal <|-- canard
Animal <|-- herisson
Animal <|-- lapin

class Inventaire{
    + int id_inventaire <<PK>>
}
Utilisateur "1" -- "0..*" Inventaire : avoir >
class Items{
    + int id_item <<PK>>
    --
    + int cout
    + String nom
}
class vetements
class jouets
class nourriture
class soin
Items "1" -- "0..*" Inventaire : contient >
note on link
    =int quantité
end note
Items <|-- vetements
Items <|-- jouets
Items <|-- nourriture
Items <|-- soin

Animal "1" -- "0..1" jouets : jouetPréféré >

class Experience{
    + int niveau
    + int xp
}
Utilisateur "1" -- "1" Experience : possède >

class Succès{
    + int id_succes <<PK>>
    --
    + String nom
    + String description
}

Utilisateur "1" -- "0..*" Succès : obtient >
note on link
    =Date date_obtention
end note

class MiniJeu{
    + int id_jeu <<PK>>
    --
    + String nom
    + int gain_argent
    + int gain_xp
    --
    + gainArgent() : int
    + gainXP() : int
}

Utilisateur "1" -- "0..*" MiniJeu : joue >

@enduml

@startuml "Cas d'utilisation"
title "Diagramme de cas d'utilisation"
left to right direction
actor Utilisateur
rectangle "Systeme"{
    usecase "S'authentifier" as UC0
    usecase "Gerer profil" as UC3
    usecase "S'occuper de l'animal" as UC1
    usecase "Donner à manger" as UC1.1
    usecase "Jouer avec" as UC1.2
    usecase "Soigner" as UC1.3
    usecase "Faire dormir" as UC1.4
    usecase "Consulter état de l'animal" as UC1.5

    UC1.>UC1.1:<<include>>
    UC1.>UC1.2:<<include>>
    UC1.>UC1.3:<<include>>
    UC1.>UC1.4:<<include>>
    UC1.>UC1.5:<<include>>

    usecase "Acheter dans la boutique" as UC2
    usecase "Consulter inventaire" as UC2.1
    usecase "Changer vêtements" as UC2.2

    UC2.>UC2.1:<<include>>
    UC2.>UC2.2:<<extend>>

    usecase "Jouer mini-jeux" as UC4
    usecase "Gagner argent et XP" as UC4.1

    UC4.>UC4.1:<<include>>

    usecase "Consulter succès" as UC5
    usecase "Recevoir récompense quotidienne" as UC6

}
Utilisateur -->UC1
Utilisateur -->UC2
Utilisateur -->UC3
Utilisateur -->UC4
Utilisateur -->UC5
Utilisateur -->UC6
@enduml

@startuml "Diagramme de séquence"
title "Diagramme de séquence global - Animochi"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurCompte" as CC
participant "ControleurAnimal" as CA
participant "ControleurBoutique" as CB
participant "ControleurMiniJeu" as CMJ

U->IJ:S'authentifier()
activate IJ
ref over IJ, CC:S'authentifier
ref over IJ, CC:Récompense Quotidienne

U->IJ:Consulter etat animal
ref over IJ, CA:Consulter etat animal
U->IJ:Nourrir animal
ref over IJ, CA:Nourrir animal
U->IJ:Jouer avec animal
ref over IJ, CA:Jouer avec animal
U->IJ:Soigner animal
ref over IJ, CA:Soigner animal
U->IJ:Faire dormir animal
ref over IJ, CA:Faire dormir animal

U->IJ:Acheter item
ref over IJ, CB:Acheter item
U->IJ:Changer vêtements
ref over IJ, CB:Changer vêtements

U->IJ:Lancer mini-jeu
ref over IJ, CMJ:Jouer mini-jeu
U->IJ:Fin de mini jeu
ref over IJ, CMJ:Fin mini-jeu
U->IJ:Voir succès
ref over IJ, CMJ:Verifier succes
deactivate IJ
@enduml

@startuml S'authentifier
title "Sous-diagramme : S'authentifier"
actor Utilisateur as U
participant InterfaceJeu as IJ
participant ControleurCompte as CC
U -> IJ : saisirIdentifiants()
IJ -> CC : verifierIdentifiants()
CC --> IJ : connexionOK()
@enduml

@startuml Recompense
title "Sous-diagramme : Récompense Quotidienne"
participant InterfaceJeu as IJ
participant ControleurCompte as CC
IJ->CC:verifierRecompense()
CC-->IJ:afficherRecompense()
@enduml

@startuml Consulter l'etat
actor Utilisateur as U
participant InterfaceJeu as IJ
participant "ControleurAnimal" as CA
participant "Animal" as A
U->IJ:Consulter état de l'animal
IJ->CA:getEtatAnimal()
CA->A:lireJauges()
A-->CA:jauges
CA-->IJ:afficherEtat()
@enduml

@startuml Nourrir
title "Sous-diagramme : Nourrir l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Nourrir animal
IJ->CA:nourrirAnimal()
CA->I:verifierNourriture()
I-->CA:quantiéOK
CA->A:augmenterFaim()
A-->CA:etatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Jouer
title "Sous-diagramme : Jouer avec l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Jouer avec l'animal
IJ->CA:jouerAvecAnimal()
CA->A:augmenterJoie()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Soigner
title "Sous-diagramme : Soigner l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Soigner animal
IJ->CA:soignerAnimal()
CA->I:verifierSoin()
I-->CA:OK
CA->A:augmenterSante()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Dormir
title "Sous-diagramme : Faire dormir l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Faire dormir
IJ->CA:faireDormir()
CA->A:augmenterFatigue()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Acheter
title "Sous-diagramme : Acheter items"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurBoutique" as CB
participant "Inventaire" as I
participant "Items" as It
U->IJ:Acheter item
IJ->CB:acheterItem(id_item)
CB->It:getItem(id_item)
It-->CB:infosItem
CB->I:ajouterItem(id_item)
I-->CB:confirmation
CB-->IJ:afficherAchat()
@enduml

@startuml Changer
title "Sous-diagramme : Changer vêtements"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Animal" as A
U->IJ:Changer vêtements
IJ->CA:appliquerVetement()
CA->A:changerVetement
A-->CA:OK
CA-->IJ:afficherVetement()
@enduml

@startuml Lancer mini-jeu
title "Sous-diagramme : Lancer mini-jeu"
actor "Utilisateur" as U
participant "InterfaceMiniJeu" as IMJ
participant "ControleurMiniJeu" as CMJ
participant "MiniJeu" as MJ
U->IMJ:Lancer mini-jeu
IMJ->CMJ:demarrerJeu(id_jeu)
CMJ->MJ:chargerInfos()
MJ-->CMJ:infosJeu
@enduml

@startuml Fin mini-jeu
title "Sous-diagramme : Fin mini-jeu"
participant "InterfaceMiniJeu" as IMJ
participant "ControleurMiniJeu" as CMJ
participant "Partie" as P
participant "Experience" as E
IMJ->CMJ:finDePartie(score)
CMJ->P:enregistrer(score)
P-->CMJ:gains(argent, xp)
CMJ->E:ajouterXP(xp)
E-->CMJ:niveauMisAJour
CMJ-->IMJ:afficherGains()
@enduml

@startuml Verifier succès
participant "InterfaceJeu" as IJ
participant "ControleurMiniJeu" as CMJ
participant "Succès" as S
CMJ->S:verifierSucces()
S-->CMJ:succesDebloques
CMJ-->IJ:afficherGainsEtSucces()
@enduml