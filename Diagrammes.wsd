@startuml "Diagramme de classe"
title "Diagramme de classes"
skinparam linetype ortho

class Utilisateur {
    + int id_client <<PK>>
    --
    + String mdp
    + String nom
    + String prenom
    + int argent
}

class Animal {
    + String nom_animal <<PK>>
    --
    + String type_animal
    + int santé
    + int famine
    + int joie
    + int fatigue
    + Date date_naissance
}
Utilisateur "1" -- "0..*" Animal : adopter >
class Chat
class perroquet
class canard
class herisson
class lapin
Animal <|-- Chat
Animal <|-- perroquet
Animal <|-- canard
Animal <|-- herisson
Animal <|-- lapin

class Inventaire{
    + int id_inventaire <<PK>>
    --
    + int quantite
}
Utilisateur "1" -- "0..*" Inventaire : avoir >
class Items{
    + int id_item <<PK>>
    --
    + int cout
    + String nom
}
class vetements
class jouets
class nourriture
class soin
Items "1" -- "0..*" Inventaire : contient >
Items <|-- vetements
Items <|-- jouets
Items <|-- nourriture
Items <|-- soin

Animal "1" -- "0..1" jouets : jouetPréféré >

class Experience{
    + int niveau
    + int xp
}
Utilisateur "1" -- "1" Experience : possède >

class Succès{
    + int id_succes <<PK>>
    --
    + String nom
    + String description
}
class UtilisateurSucces {
    + Date date_obtention
}
Utilisateur "1" -- "0..*" UtilisateurSucces
Succès "1" -- "0..*" UtilisateurSucces

class MiniJeu{
    + int id_jeu <<PK>>
    --
    + String nom
    + int gain_argent
    + int gain_xp
}
class Partie {
    + int gain_argent
    + int gain_xp
    + Date date
}

Utilisateur "1" -- "0..*" Partie : joue >
MiniJeu "1" -- "0..*" Partie : est_joué >

@enduml

@startuml "Cas d'utilisation"
title "Diagramme de cas d'utilisation"
left to right direction
actor Utilisateur
rectangle "Systeme"{
    usecase "S'authentifier" as UC0
    usecase "Gerer profil" as UC3
    usecase "S'occuper de l'animal" as UC1
    usecase "Donner à manger" as UC1.1
    usecase "Jouer avec" as UC1.2
    usecase "Soigner" as UC1.3
    usecase "Faire dormir" as UC1.4
    usecase "Consulter état de l'animal" as UC1.5

    UC1.>UC1.1:<<include>>
    UC1.>UC1.2:<<include>>
    UC1.>UC1.3:<<include>>
    UC1.>UC1.4:<<include>>
    UC1.>UC1.5:<<include>>

    usecase "Acheter dans la boutique" as UC2
    usecase "Consulter inventaire" as UC2.1
    usecase "Changer vêtements" as UC2.2

    UC2.>UC2.1:<<include>>
    UC2.>UC2.2:<<extend>>

    usecase "Jouer mini-jeux" as UC4
    usecase "Gagner argent et XP" as UC4.1

    UC4.>UC4.1:<<include>>

    usecase "Consulter succès" as UC5
    usecase "Recevoir récompense quotidienne" as UC6

}
Utilisateur -->UC1
Utilisateur -->UC2
Utilisateur -->UC3
Utilisateur -->UC4
Utilisateur -->UC5
Utilisateur -->UC6
@enduml

@startuml "Diagramme de séquence"
title "Diagramme de séquence global - Animochi"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurCompte" as CC
participant "ControleurAnimal" as CA
participant "ControleurBoutique" as CB
participant "ControleurMiniJeu" as CMJ
participant "Inventaire" as I
participant "Animal" as A
participant "Items" as It
participant "MiniJeu" as MJ
participant "Partie" as P
participant "Experience" as E
participant "Succès" as S

U->IJ:S'authentifier()
activate IJ
IJ->CC:verifierIdentifiants()
CC-->IJ:connexionOK()

IJ->CC:verifierRecompense()
CC-->IJ:afficherRecompense()

U->IJ:Consulter état de l'animal
IJ->CA:getEtatAnimal()
CA->A:lireJauges()
A-->CA:jauges
CA-->IJ:afficherEtat()

U->IJ:Nourrir animal
IJ->CA:nourrirAnimal()
CA->I:verifierNourriture()
I-->CA:quantiéOK
CA->A:augmenterFaim()
A-->CA:etatMisAJour
CA-->IJ:afficherNouvelEtat()

U->IJ:Jouer avec l'animal
IJ->CA:jouerAvecAnimal()
CA->A:augmenterJoie()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()

U->IJ:Soigner animal
IJ->CA:soignerAnimal()
CA->I:verifierSoin()
I-->CA:OK
CA->A:augmenterSante()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()

U->IJ:Faire dormir
IJ->CA:faireDormir()
CA->A:augmenterFatigue()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()

U->IJ:Acheter item
IJ->CB:acheterItem(id_item)
CB->It:getItem(id_item)
It-->CB:infosItem
CB->I:ajouterItem(id_item)
I-->CB:confirmation
CB-->IJ:afficherAchat()

U->IJ:Changer vêtements
IJ->CA:appliquerVetement()
CA->A:changerVetement
A-->CA:OK
CA-->IJ:afficherVetement()

U->IJ:Lancer mini-jeu
IJ->CMJ:demarrerJeu(id_jeu)
CMJ->MJ:chargerInfos()
MJ-->CMJ:infosJeu
'--jsp s'il faut faire dans un cas different la fin du jeu--'
IJ->CMJ:finDePartie(score)
CMJ->P:enregistrer(score)
P-->CMJ:gains(argent, xp)
CMJ->E:ajouterXP(xp)
E-->CMJ:niveauMisAJour
CMJ->S:verifierSucces()
S-->CMJ:succesDebloques

CMJ-->IJ:afficherGainsEtSucces()
deactivate IJ
@enduml