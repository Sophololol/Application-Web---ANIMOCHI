@startuml "Diagramme de classe"
title "Diagramme de classes"
skinparam linetype ortho

class Utilisateur {
    + int id_client <<PK>>
    --
    + String mdp
    + String nom
    + String prenom
    + int argent
}

class Animal {
    + String nom_animal <<PK>>
    --
    + String type_animal
    + int santé
    + int famine
    + int joie
    + int fatigue
    + Date date_naissance
}
Utilisateur "1" -- "0..*" Animal : adopter >
class Chat
class perroquet
class canard
class herisson
class lapin
Animal <|-- Chat
Animal <|-- perroquet
Animal <|-- canard
Animal <|-- herisson
Animal <|-- lapin

class Inventaire{
    + int id_inventaire <<PK>>
    --
    + int quantite
}
Utilisateur "1" -- "0..*" Inventaire : avoir >
class Items{
    + int id_item <<PK>>
    --
    + int cout
    + String nom
}
class vetements
class jouets
class nourriture
class soin
Items "1" -- "0..*" Inventaire : contient >
Items <|-- vetements
Items <|-- jouets
Items <|-- nourriture
Items <|-- soin

Animal "1" -- "0..1" jouets : jouetPréféré >

class Experience{
    + int niveau
    + int xp
}
Utilisateur "1" -- "1" Experience : possède >

class Succès{
    + int id_succes <<PK>>
    --
    + String nom
    + String description
}
class UtilisateurSucces {
    + Date date_obtention
}
Utilisateur "1" -- "0..*" UtilisateurSucces
Succès "1" -- "0..*" UtilisateurSucces

class MiniJeu{
    + int id_jeu <<PK>>
    --
    + String nom
    + int gain_argent
    + int gain_xp
}
class Partie {
    + int gain_argent
    + int gain_xp
    + Date date
}

Utilisateur "1" -- "0..*" Partie : joue >
MiniJeu "1" -- "0..*" Partie : est_joué >

@enduml

@startuml "Cas d'utilisation"
title "Diagramme de cas d'utilisation"
left to right direction
actor Utilisateur
rectangle "Systeme"{
    usecase "S'authentifier" as UC0
    usecase "Gerer profil" as UC3
    usecase "S'occuper de l'animal" as UC1
    usecase "Donner à manger" as UC1.1
    usecase "Jouer avec" as UC1.2
    usecase "Soigner" as UC1.3
    usecase "Faire dormir" as UC1.4
    usecase "Consulter état de l'animal" as UC1.5

    UC1.>UC1.1:<<include>>
    UC1.>UC1.2:<<include>>
    UC1.>UC1.3:<<include>>
    UC1.>UC1.4:<<include>>
    UC1.>UC1.5:<<include>>

    usecase "Acheter dans la boutique" as UC2
    usecase "Consulter inventaire" as UC2.1
    usecase "Changer vêtements" as UC2.2

    UC2.>UC2.1:<<include>>
    UC2.>UC2.2:<<extend>>

    usecase "Jouer mini-jeux" as UC4
    usecase "Gagner argent et XP" as UC4.1

    UC4.>UC4.1:<<include>>

    usecase "Consulter succès" as UC5
    usecase "Recevoir récompense quotidienne" as UC6

}
Utilisateur -->UC1
Utilisateur -->UC2
Utilisateur -->UC3
Utilisateur -->UC4
Utilisateur -->UC5
Utilisateur -->UC6
@enduml

@startuml "Diagramme de séquence"
title "Diagramme de séquence"
@enduml