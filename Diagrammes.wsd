@startuml "Diagramme de classe"
title "Diagramme de classes"
skinparam linetype ortho

class utilisateur {
    + int id_client <<PK>>
    --
    + String mdp
    + String nom
    + String prenom
    + int argent
}

class Animal {
    + String nom_animal <<PK>>
    --
    + String type_animal
    + int santé
    + int famine
    + int joie
    + int fatigue
    + Date date_naissance
}

class Chat
class perroquet
class canard
class herisson
class lapin

class Items{
    + cout
}
class vetements{

}
class jouets{

}
class nourriture
class soin

utilisateur "1" -- "1..*" Animal : adopter >
utilisateur "1"--"0..*" Items : acheter >
Items -- vetements
Items -- jouets
Items -- nourriture
Items -- soin
Animal -- Chat
Animal -- perroquet
Animal -- canard
Animal -- herisson
Animal -- lapin

@enduml

@startuml "Cas d'utilisation"
title "Diagramme de cas d'utilisation"
left to right direction
actor Utilisateur
rectangle "Systeme"{
    usecase "Gerer compte" as UC3
    usecase "S'occuper de l'animal" as UC1
    usecase "Donner à manger" as UC1.1
    usecase "Joeur avec" as UC1.2
    usecase "Soigner" as UC1.3
    usecase "Faire dormir" as UC1.4
    usecase "Jouer mini-jeux" as UC2
    usecase "Acheter dans la boutique" as UC4

    UC1.>UC1.1:<<include>>
    UC1.>UC1.2:<<include>>
    UC1.>UC1.3:<<include>>
    UC1.>UC1.4:<<include>>
}
Utilisateur -->UC1
Utilisateur -->UC2
Utilisateur -->UC3
Utilisateur -->UC4
@enduml

@startuml "Diagramme de séquence"
title "Diagramme de séquence"
@enduml