@startuml "Diagramme de classe"
title "Diagramme de classes - ANIMOCHI"
skinparam linetype ortho

class Utilisateur {
    + int id_client <<PK>>
    --
    + String mdp
    + String nom
    + String prenom
    + int argent
    + int niveau
    + int xp
    --
    + seConnecter(mdp : String) : boolean
}

class Animal {
    + String nom_animal <<PK>>
    --
    + String type_animal
    + int santé
    + int famine
    + int joie
    + int fatigue
    + Date date_naissance
    --
    + nourrir() : void
    + jouer() : void
    + dormir() : void
    + soigner() : void
}
Utilisateur "1" -- "0..*" Animal : adopter >
class Chat
Animal <|-- Chat

class Inventaire{
    + int id_inventaire <<PK>>
}
Utilisateur "1" -- "0..*" Inventaire : avoir >
class Items{
    + int id_item <<PK>>
    --
    + int cout
    + String nom
}
class vetements
class jouets
class nourriture{
    + int satiété
}
class soin
Items "1" -- "0..*" Inventaire : contient >
note on link
    =int quantité
end note
Items <|-- vetements
Items <|-- jouets
Items <|-- nourriture
Items <|-- soin

Animal "1" -- "0..1" jouets : jouetPréféré >

class Succès{
    + int id_succes <<PK>>
    --
    + String nom
    + String description
}

Utilisateur "1" -- "0..*" Succès : obtient >
note on link
    =Date date_obtention
end note

class MiniJeu{
    + int id_jeu <<PK>>
    --
    + String nom
    + int gain_argent
    + int gain_xp
    --
    + gainArgent() : int
    + gainXP() : int
}
class Memory
class 2048
class Dino
MiniJeu <|-- Memory
MiniJeu <|-- 2048
MiniJeu <|-- Dino

Utilisateur "1" -- "0..*" MiniJeu : joue >

@enduml

@startuml "Cas d'utilisation"
title "Diagramme de cas d'utilisation - ANIMOCHI"
left to right direction
actor Utilisateur
rectangle "Systeme"{
    usecase "S'authentifier" as UC0
    usecase "Acceder boutique" as UC3
    usecase "S'occuper de l'animal" as UC1
    usecase "Donner à manger" as UC1.1
    usecase "Jouer avec" as UC1.2
    usecase "Soigner" as UC1.3
    usecase "Faire dormir" as UC1.4
    usecase "Consulter état de l'animal" as UC1.5

    UC1.>UC1.1:<<include>>
    UC1.>UC1.2:<<include>>
    UC1.>UC1.3:<<include>>
    UC1.>UC1.4:<<include>>
    UC1.>UC1.5:<<include>>

    usecase "Acheter dans la boutique" as UC2
    usecase "Consulter inventaire" as UC2.1
    usecase "Changer vêtements" as UC2.2

    UC2.>UC2.1:<<include>>
    UC2.>UC2.2:<<extend>>

    usecase "Jouer mini-jeux" as UC4
    usecase "Gagner argent et XP" as UC4.1

    UC4.>UC4.1:<<include>>

    usecase "Consulter succès" as UC5
    usecase "Recevoir récompense quotidienne" as UC6

}
Utilisateur -->UC1
Utilisateur -->UC2
Utilisateur -->UC3
Utilisateur -->UC4
Utilisateur -->UC5
Utilisateur -->UC6
@enduml

@startuml "Diagramme de séquence"
title "Diagramme de séquence global - Animochi"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurCompte" as CC
participant "ControleurAnimal" as CA
participant "Animal" as A
participant "Inventaire" as I
participant "Items" as It
participant "ControleurBoutique" as CB
participant "InterfaceMiniJeu" as IMJ
participant "ControleurMiniJeu" as CMJ
participant "MiniJeu" as MJ
participant "Partie" as P
participant "Experience" as E
participant "Succès" as S

U->IJ:S'authentifier()
activate IJ
alt Client non authentifié 
    U -> IJ : saisirIdentifiants()
    IJ -> CC : verifierIdentifiants()
    CC --> IJ : connexionOK()
    
    opt Recompense Quoitidienne disponible
        IJ->CC:verifierRecompense()
        CC-->IJ:afficherRecompense()
    end
else Client déjà authentifie
    'Rien à faire
end

opt L'utilisateur consulte l'état de l'animal
    U->IJ:Consulter état de l'animal
    IJ->CA:getEtatAnimal()
    CA->A:lireJauges()
    A-->CA:jauges
    CA-->IJ:afficherEtat()
end

opt L'utilisateur nourrit l'animal
    U->IJ:Nourrir animal
    IJ->CA:nourrirAnimal()
    CA->I:verifierNourriture()
    I-->CA:quantitéOK
    CA->A:augmenterFaim()
    A-->CA:etatMisAJour
    CA-->IJ:afficherNouvelEtat()
end

opt L'utilisateur joue avec l'animal
    U->IJ:Jouer avec animal
    ref over IJ, CA:Jouer avec animal
end

opt L'utilisateur soigne l'animal
    U->IJ:Soigner animal
    ref over IJ, CA:Soigner animal
end

opt L'utilisateur fait dormir l'animal
    U->IJ:Faire dormir animal
    ref over IJ, CA:Faire dormir animal
end

opt L'utilisateur achète un item
    U->IJ:Acheter item
    IJ->CB:acheterItem(id_item)
    CB->It:getItem(id_item)
    It-->CB:infosItem
    CB->I:ajouterItem(id_item)
    I-->CB:confirmation
    CB-->IJ:afficherAchat()
end

opt L'utilisateur change les vêtements
    U->IJ:Changer vêtements
    IJ->CA:appliquerVetement()
    CA->A:changerVetement
    A-->CA:OK
    CA-->IJ:afficherVetement()
end

opt L’utilisateur lance un mini-jeu
    U->IJ:Lancer mini-jeu
    IJ->CMJ:demarrerJeu(id_jeu)
    CMJ->MJ:chargerInfos()
    MJ-->CMJ:infosJeu

    U->IJ:Fin de mini jeu
    IJ->CMJ:finDePartie(score)
    CMJ->P:enregistrer(score)
    P-->CMJ:gains(argent, xp)
    CMJ->E:ajouterXP(xp)
    E-->CMJ:niveauMisAJour
    CMJ-->IJ:afficherGains()

    IJ->CMJ:Verifier succes
    CMJ->S:verifierSucces()
    S-->CMJ:succesDebloques
    CMJ-->IJ:afficherGainsEtSucces()
end
deactivate IJ
@enduml

@startuml Jouer
title "Sous-diagramme : Jouer avec l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Jouer avec l'animal
IJ->CA:jouerAvecAnimal()
CA->A:augmenterJoie()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Soigner
title "Sous-diagramme : Soigner l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Soigner animal
IJ->CA:soignerAnimal()
CA->I:verifierSoin()
I-->CA:OK
CA->A:augmenterSante()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml

@startuml Dormir
title "Sous-diagramme : Faire dormir l'animal"
actor "Utilisateur" as U
participant "InterfaceJeu" as IJ
participant "ControleurAnimal" as CA
participant "Inventaire" as I
participant "Animal" as A
U->IJ:Faire dormir
IJ->CA:faireDormir()
CA->A:augmenterFatigue()
A-->CA:étatMisAJour
CA-->IJ:afficherNouvelEtat()
@enduml
